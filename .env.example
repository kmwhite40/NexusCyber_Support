# Nexus Platform — environment template. Copy to .env and adjust.

# --- Database ---
# Owner/admin connection (migrate, seed, system jobs). Bypasses RLS to bootstrap.
DATABASE_URL=postgres://nexus:nexus@localhost:5432/nexus
# Runtime connection as a NON-owner role so Row-Level Security is enforced on requests.
# Created by migration 0001 (role nexus_app).
APP_DATABASE_URL=postgres://nexus_app:nexus_app@localhost:5432/nexus

# --- API ---
API_PORT=4000
# Dev-only signing key for local session JWTs. In production use Key Vault / managed identity.
SESSION_SIGNING_KEY=dev-only-insecure-change-me
# Comma-separated allowed origins for CORS (the web app)
WEB_ORIGIN=http://localhost:3000

# --- Enclave / cloud ---
# Which enclave this API instance serves: commercial | gov
ENCLAVE=commercial

# --- Web ---
NEXT_PUBLIC_API_BASE=http://localhost:4000/api/v1
