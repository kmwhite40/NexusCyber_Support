# Nexus Platform — environment template. Copy to .env and adjust.

# --- Database ---
# Owner/admin connection (migrate, seed, system jobs). Bypasses RLS to bootstrap.
DATABASE_URL=postgres://nexus:nexus@localhost:5432/nexus
# Runtime connection as a NON-owner role so Row-Level Security is enforced on requests.
# Created by migration 0001 (role nexus_app).
APP_DATABASE_URL=postgres://nexus_app:nexus_app@localhost:5432/nexus

# --- API ---
API_PORT=4000
# Dev-only signing key for local session JWTs. In production use Key Vault / managed identity.
SESSION_SIGNING_KEY=dev-only-insecure-change-me
# Comma-separated allowed origins for CORS (the web app)
WEB_ORIGIN=http://localhost:3000

# --- Enclave / cloud ---
# Which enclave this API instance serves: commercial | gov
ENCLAVE=commercial

# --- Web ---
NEXT_PUBLIC_API_BASE=http://localhost:4000/api/v1

# --- Microsoft 365 (GCC) integration ---
# Master switch. When false/absent, notifications use the dev console transport.
M365_ENABLED=false
# Cloud: commercial | gcc | gcchigh | azgov. GCC uses the commercial endpoints.
M365_CLOUD=gcc
# App registration (client-credentials / app-only). Mail.Send application permission.
M365_TENANT_ID=
M365_CLIENT_ID=
M365_CLIENT_SECRET=
# UPN of the enclave service mailbox that sends and receives notifications.
M365_SERVICE_MAILBOX=
# Inbound mail -> ticket polling, and Teams channel posting (off until validated).
M365_INGEST_ENABLED=false
M365_TEAMS_ENABLED=false

# --- Notifications ---
# Shared service-desk mailbox that receives new-ticket notifications when the
# owning assignment group has no notification_email. Unset in production = no
# new-ticket email (team uses the queue); dev defaults to service-desk@nexus.example.com.
SERVICE_DESK_EMAIL=

# Seed demo data (Demo Corp + the admin<->customer toggle account). Set to 0 for a
# clean platform with no demo customers/tickets (real customers come via registration).
SEED_DEMO=1

# ---- Per-customer Entra/Intune device sync ----
# AES-256-GCM master key (32 bytes, base64) for the customer client secrets stored in
# org_integrations. Key Vault is blocked by enclave policy, so this is the key.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Without it the sync stays off no matter what ENTRA_SYNC_ENABLED says, and any secret
# already stored under a previous key becomes unrecoverable.
INTEGRATION_ENC_KEY=
ENTRA_SYNC_ENABLED=false
# Default 6h. Each tick is a full enumeration per configured customer.
ENTRA_SYNC_INTERVAL_MS=21600000
