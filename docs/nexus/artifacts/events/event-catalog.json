{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Nexus Event Catalog",
  "description": "Machine-readable catalog of domain events. Reference for docs/nexus/09-data-api-events.md (Section U). Each event envelope shares common fields; 'data' is event-specific.",
  "version": "1.0.0-draft",
  "envelope": {
    "type": "object",
    "required": ["event_id", "type", "occurred_at", "data", "idempotency_key", "version"],
    "properties": {
      "event_id": { "type": "string", "description": "ULID/UUID unique per event" },
      "type": { "type": "string" },
      "occurred_at": { "type": "string", "format": "date-time" },
      "organization_id": { "type": ["string", "null"], "format": "uuid" },
      "enclave": { "type": "string", "enum": ["commercial", "gov"] },
      "correlation_id": { "type": "string" },
      "idempotency_key": { "type": "string" },
      "version": { "type": "integer" },
      "data": { "type": "object" }
    }
  },
  "events": [
    { "type": "organization.created", "order_key": null, "data": { "org_id": "uuid", "cloud": "string", "enclave": "string" } },
    { "type": "user.created", "order_key": null, "data": { "user_id": "uuid", "org_id": "uuid|null", "plane": "string" } },
    { "type": "ticket.created", "order_key": "ticket_id", "data": { "ticket_id": "uuid", "org_id": "uuid", "type": "string", "priority": "string", "requester_id": "uuid", "channel": "string" } },
    { "type": "ticket.updated", "order_key": "ticket_id", "data": { "ticket_id": "uuid", "org_id": "uuid", "changed_fields": "string[]" } },
    { "type": "ticket.assigned", "order_key": "ticket_id", "data": { "ticket_id": "uuid", "org_id": "uuid", "group_id": "uuid|null", "agent_id": "uuid|null" } },
    { "type": "ticket.commented", "order_key": "ticket_id", "data": { "ticket_id": "uuid", "org_id": "uuid", "comment_id": "uuid", "visibility": "customer|internal" } },
    { "type": "ticket.status_changed", "order_key": "ticket_id", "data": { "ticket_id": "uuid", "org_id": "uuid", "from": "string", "to": "string" } },
    { "type": "ticket.priority_changed", "order_key": "ticket_id", "data": { "ticket_id": "uuid", "org_id": "uuid", "from": "string", "to": "string" } },
    { "type": "ticket.escalated", "order_key": "ticket_id", "data": { "ticket_id": "uuid", "org_id": "uuid", "reason": "string", "to_target": "string" } },
    { "type": "ticket.resolved", "order_key": "ticket_id", "data": { "ticket_id": "uuid", "org_id": "uuid", "resolution_code": "string" } },
    { "type": "ticket.closed", "order_key": "ticket_id", "data": { "ticket_id": "uuid", "org_id": "uuid" } },
    { "type": "ticket.reopened", "order_key": "ticket_id", "data": { "ticket_id": "uuid", "org_id": "uuid" } },
    { "type": "sla.started", "order_key": "ticket_id", "data": { "sla_instance_id": "uuid", "ticket_id": "uuid", "org_id": "uuid", "metric": "string", "due_at": "date-time" } },
    { "type": "sla.paused", "order_key": "ticket_id", "data": { "sla_instance_id": "uuid", "ticket_id": "uuid", "org_id": "uuid", "metric": "string" } },
    { "type": "sla.warning", "order_key": "ticket_id", "data": { "sla_instance_id": "uuid", "ticket_id": "uuid", "org_id": "uuid", "metric": "string", "due_at": "date-time" } },
    { "type": "sla.breached", "order_key": "ticket_id", "data": { "sla_instance_id": "uuid", "ticket_id": "uuid", "org_id": "uuid", "metric": "string", "due_at": "date-time", "breached_at": "date-time" } },
    { "type": "oncall.page_created", "order_key": "page_id", "data": { "page_id": "uuid", "ticket_id": "uuid|null", "schedule": "string", "severity": "string" } },
    { "type": "oncall.acknowledgement_required", "order_key": "page_id", "data": { "page_id": "uuid", "responder": "uuid", "deadline": "date-time" } },
    { "type": "oncall.acknowledged", "order_key": "page_id", "data": { "page_id": "uuid", "responder": "uuid", "via": "string" } },
    { "type": "oncall.escalated", "order_key": "page_id", "data": { "page_id": "uuid", "from_responder": "uuid", "to_responder": "uuid" } },
    { "type": "notification.queued", "order_key": "delivery_id", "data": { "delivery_id": "uuid", "channel": "string", "recipient": "string" } },
    { "type": "notification.sent", "order_key": "delivery_id", "data": { "delivery_id": "uuid", "channel": "string", "recipient": "string" } },
    { "type": "notification.failed", "order_key": "delivery_id", "data": { "delivery_id": "uuid", "channel": "string", "recipient": "string", "reason": "string" } },
    { "type": "posture.finding_created", "order_key": "finding_id", "data": { "finding_id": "uuid", "org_id": "uuid", "severity": "string", "domain": "string" } },
    { "type": "posture.finding_updated", "order_key": "finding_id", "data": { "finding_id": "uuid", "org_id": "uuid", "status": "string" } },
    { "type": "posture.finding_remediated", "order_key": "finding_id", "data": { "finding_id": "uuid", "org_id": "uuid" } },
    { "type": "posture.exception_requested", "order_key": "finding_id", "data": { "exception_id": "uuid", "finding_id": "uuid", "requested_by": "uuid" } },
    { "type": "posture.exception_approved", "order_key": "finding_id", "data": { "exception_id": "uuid", "finding_id": "uuid", "approver": "uuid", "expires_at": "date-time" } },
    { "type": "approval.requested", "order_key": "approval_id", "data": { "approval_id": "uuid", "subject_type": "string", "subject_id": "uuid" } },
    { "type": "approval.approved", "order_key": "approval_id", "data": { "approval_id": "uuid", "approver": "uuid" } },
    { "type": "approval.rejected", "order_key": "approval_id", "data": { "approval_id": "uuid", "approver": "uuid", "reason": "string" } },
    { "type": "change.requested", "order_key": "change_id", "data": { "change_id": "uuid", "org_id": "uuid", "window": "object" } },
    { "type": "change.approved", "order_key": "change_id", "data": { "change_id": "uuid", "approver": "uuid" } },
    { "type": "change.completed", "order_key": "change_id", "data": { "change_id": "uuid" } },
    { "type": "integration.connected", "order_key": "integration_id", "data": { "integration_id": "uuid", "org_id": "uuid", "capability": "string" } },
    { "type": "integration.failed", "order_key": "integration_id", "data": { "integration_id": "uuid", "org_id": "uuid", "capability": "string", "reason": "string" } },
    { "type": "integration.permission_expired", "order_key": "integration_id", "data": { "integration_id": "uuid", "org_id": "uuid", "scope": "string" } },
    { "type": "automation.executed", "order_key": "execution_id", "data": { "execution_id": "uuid", "rule_id": "uuid", "version": "integer", "outcome": "string" } },
    { "type": "automation.failed", "order_key": "execution_id", "data": { "execution_id": "uuid", "rule_id": "uuid", "version": "integer", "error": "string" } },
    { "type": "audit.privileged_action", "order_key": null, "data": { "actor_id": "uuid", "action": "string", "resource": "string", "scope": "string" } }
  ]
}
